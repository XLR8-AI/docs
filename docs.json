{
  "$schema": "https://mintlify.com/docs.json",
  "name": "XLR8.ai",
  "theme": "luma",
  "logo": {
    "light": "/images/xlr8-logo-light.png",
    "dark": "/images/xlr8-logo-dark.png",
    "href": "https://app.tryxlr8.ai"
  },
  "favicon": "/images/favicon.ico",
  "colors": {
    "primary": "#1c64ec",
    "light": "#ffffff"
  },
  "navbar": {
    "primary": {
      "type": "button",
      "label": "Get Started",
      "href": "https://app.tryxlr8.ai"
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Get Started",
            "pages": [
              "introduction",
              "quickstart",
              "concepts",
              "changelog"
            ]
          },
          {
            "group": "Experiments",
            "pages": [
              "experiments/overview",
              "query-generation",
              "experiments/visibility",
              "experiments/sentiment",
              "experiments/results",
              "experiments/scheduling"
            ]
          },
          {
            "group": "Reporting",
            "pages": [
              "analytics/overview",
              "reporting/overview"
            ]
          },
          {
            "group": "Content",
            "pages": [
              "content/overview",
              "content/generation",
              "content/optimization",
              "content/videos"
            ]
          },
          {
            "group": "Intelligence",
            "pages": [
              "intelligence/insights-agent",
              "intelligence/action-center",
              "intelligence/social-listening",
              "outreach/overview",
              "intelligence/aeo-audit"
            ]
          },
          {
            "group": "Integrations",
            "pages": [
              "integrations/webflow",
              "integrations/wordpress",
              "indexing/overview",
              "integrations/settings"
            ]
          },
          {
            "group": "Account",
            "pages": [
              "account/authentication",
              "account/billing"
            ]
          }
        ]
      }
    ]
  },
  "redirects": [
    {
      "source": "/account/plans",
      "destination": "/account/authentication",
      "permanent": true
    }
  ]
}
